# Set strong, unique values in .env.local for local preview and in Vercel
# project environment variables for production. Never commit real values.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Private Supabase project API URL and server-only secret key.
# Never use NEXT_PUBLIC_ for the secret key.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Local filesystem queue for testing only. Never set on Vercel.
REVIEW_STORAGE_MODE=local
